{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.ts"
  ],
  "resolve": {
    "conditions": [
      "@fundamentry/source"
    ]
  },
  "rules": {
    "unused-dependencies": "warn",
    "private-type-leaks": "error",
    "require-suppression-reason": "error"
  },
  "health": {
    "coverage": "coverage/coverage-final.json",
    "maxCrap": 5,
    "maxCyclomatic": 5,
    "maxCognitive": 5,
    "maxUnitSize": 20,
    "crapRefactorBand": 2,
    "ignore": [
      "vitest.setup.ts"
    ]
  },
  "production": {
    "health": true
  },
  "boundaries": {
    "zones": [
      {
        "name": "codec",
        "patterns": [
          "src/codec/**"
        ]
      },
      {
        "name": "error",
        "patterns": [
          "src/error/**"
        ]
      },
      {
        "name": "lexer",
        "patterns": [
          "src/lexer/**"
        ]
      },
      {
        "name": "parser",
        "patterns": [
          "src/parser/**"
        ]
      },
      {
        "name": "printer",
        "patterns": [
          "src/printer/**"
        ]
      },
      {
        "name": "production",
        "patterns": [
          "src/production/**"
        ]
      },
      {
        "name": "recognition",
        "patterns": [
          "src/recognition/**"
        ]
      },
      {
        "name": "rule",
        "patterns": [
          "src/rule/**"
        ]
      },
      {
        "name": "symbol",
        "patterns": [
          "src/symbol/**"
        ]
      },
      {
        "name": "tree",
        "patterns": [
          "src/tree/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "codec",
        "allow": [
          "error",
          "tree"
        ]
      },
      {
        "from": "error",
        "allow": []
      },
      {
        "from": "lexer",
        "allow": [
          "error"
        ]
      },
      {
        "from": "parser",
        "allow": [
          "error",
          "lexer",
          "recognition",
          "rule"
        ]
      },
      {
        "from": "printer",
        "allow": []
      },
      {
        "from": "production",
        "allow": [
          "codec",
          "tree"
        ]
      },
      {
        "from": "recognition",
        "allow": []
      },
      {
        "from": "rule",
        "allow": [
          "recognition"
        ]
      },
      {
        "from": "symbol",
        "allow": [
          "error",
          "tree",
          "production"
        ]
      },
      {
        "from": "tree",
        "allow": []
      }
    ]
  },
  "ignoreDependencies": [
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "eslint-config-airbnb-base",
    "eslint-config-prettier",
    "eslint-import-resolver-typescript",
    "eslint-plugin-deprecation",
    "eslint-plugin-import",
    "eslint-plugin-json-format",
    "eslint-plugin-prettier",
    "fallow"
  ],
  "ignoreExports": [
    {
      "file": "src/**/*.ts",
      "exports": [
        "*"
      ]
    }
  ]
}
