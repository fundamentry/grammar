{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/index.ts"
  ],
  "resolve": {
    "conditions": [
      "@fundamentry/source"
    ]
  },
  "rules": {
    "unused-dependencies": "warn",
    "private-type-leaks": "error",
    "require-suppression-reason": "error"
  },
  "usedClassMembers": [
    {
      "implements": "Expression.Visitor",
      "members": [
        "terminal",
        "concatenation",
        "alternation",
        "optional",
        "repetition",
        "label",
        "rule",
        "reference"
      ]
    },
    {
      "implements": "Expression.Composites",
      "members": [
        "concatenation",
        "alternation",
        "optional",
        "repetition",
        "label",
        "rule",
        "reference"
      ]
    }
  ],
  "health": {
    "coverage": "coverage/coverage-final.json",
    "maxCrap": 5,
    "maxCyclomatic": 5,
    "maxCognitive": 5,
    "maxUnitSize": 20,
    "crapRefactorBand": 2,
    "ignore": [
      "vitest.setup.ts"
    ]
  },
  "production": {
    "health": true
  },
  "boundaries": {
    "zones": [
      {
        "name": "cache",
        "patterns": [
          "src/cache/**"
        ]
      },
      {
        "name": "codec",
        "patterns": [
          "src/codec/**"
        ]
      },
      {
        "name": "data",
        "patterns": [
          "src/data/**"
        ]
      },
      {
        "name": "definition",
        "patterns": [
          "src/definition/**"
        ]
      },
      {
        "name": "expectation",
        "patterns": [
          "src/expectation/**"
        ]
      },
      {
        "name": "expression",
        "patterns": [
          "src/expression/**"
        ]
      },
      {
        "name": "mismatch",
        "patterns": [
          "src/mismatch/**"
        ]
      },
      {
        "name": "misprint",
        "patterns": [
          "src/misprint/**"
        ]
      },
      {
        "name": "parser",
        "patterns": [
          "src/parser/**"
        ]
      },
      {
        "name": "printer",
        "patterns": [
          "src/printer/**"
        ]
      },
      {
        "name": "rule",
        "patterns": [
          "src/rule/**"
        ]
      },
      {
        "name": "tree",
        "patterns": [
          "src/tree/**"
        ]
      }
    ],
    "rules": [
      {
        "from": "cache",
        "allow": []
      },
      {
        "from": "codec",
        "allow": [
          "data",
          "definition",
          "expectation",
          "expression",
          "mismatch",
          "misprint",
          "parser",
          "printer",
          "tree"
        ]
      },
      {
        "from": "data",
        "allow": []
      },
      {
        "from": "definition",
        "allow": [
          "data",
          "expectation",
          "expression",
          "tree"
        ]
      },
      {
        "from": "expectation",
        "allow": [
          "data"
        ]
      },
      {
        "from": "expression",
        "allow": [
          "expectation",
          "tree"
        ]
      },
      {
        "from": "mismatch",
        "allow": [
          "data",
          "expectation"
        ]
      },
      {
        "from": "misprint",
        "allow": [
          "data"
        ]
      },
      {
        "from": "parser",
        "allow": [
          "cache",
          "data",
          "expectation",
          "expression",
          "mismatch",
          "tree"
        ]
      },
      {
        "from": "printer",
        "allow": [
          "cache",
          "expectation",
          "expression",
          "misprint",
          "tree"
        ]
      },
      {
        "from": "rule",
        "allow": [
          "codec",
          "tree"
        ]
      },
      {
        "from": "tree",
        "allow": [
          "data"
        ]
      }
    ]
  },
  "ignoreDependencies": [
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "eslint-config-airbnb-base",
    "eslint-config-prettier",
    "eslint-import-resolver-typescript",
    "eslint-plugin-deprecation",
    "eslint-plugin-import",
    "eslint-plugin-json-format",
    "eslint-plugin-prettier",
    "fallow"
  ],
  "ignoreExports": [
    {
      "file": "src/**/*.ts",
      "exports": [
        "*"
      ]
    }
  ]
}
